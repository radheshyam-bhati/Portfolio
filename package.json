{
  "name": "radheshyam-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config frontend/vite.config.js",
    "dev:server": "node --watch backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "lint": "eslint \"frontend/src/**/*.js\" \"backend/**/*.js\"",
    "verify": "npm run lint && npm run build",
    "start": "node backend/server.js",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  }
}
